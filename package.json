{
  "name": "jsonschema-to-typings",
  "version": "0.2.14",
  "description": "A command-line utility and module to turn a JSON Schema into a typescript interface definition",
  "keywords": [
    "command-line",
    "converter",
    "interface",
    "json-schema",
    "typescript",
    "typings"
  ],
  "homepage": "https://github.com/SpringTree/jsonschema-to-typings#readme",
  "bugs": {
    "url": "https://github.com/SpringTree/jsonschema-to-typings/issues"
  },
  "license": "ISC",
  "author": {
    "name": "Mark Doeswijk",
    "email": "mdoeswijk@gmail.com",
    "url": "https://github.com/Qwerios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpringTree/jsonschema-to-typings.git"
  },
  "bin": {
    "jsonschema2typings": "./bin/schema2ts.js"
  },
  "main": "./lib/index.js",
  "scripts": {
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^2.20.0",
    "jsonfile": "^5.0.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@types/lodash": "^4.17.27",
    "bunup": "^0.16.32",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  }
}
